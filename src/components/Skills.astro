---
import SectionHeading from './SectionHeading.astro';
import { skills } from '../data/resume';
---

<section class="section" id="skills">
  <div class="wrap">
    <SectionHeading index="06" label="Skills" title="Tools and methods I work with." />
    <div class="grid gap-x-10 gap-y-8">
      {
        skills.map((group) => (
          <div class="grid gap-x-10 gap-y-3 border-t border-line pt-6 md:grid-cols-[11rem_1fr]">
            <h3 class="eyebrow pt-1.5" data-reveal>
              {group.group}
            </h3>
            <ul class="flex flex-wrap gap-2">
              {group.items.map((item, i) => (
                <li class="tag" data-reveal style={`--i:${i * 0.5}`}>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
