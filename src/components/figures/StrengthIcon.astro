---
interface Props {
  name: 'product' | 'code' | 'growth';
}
const { name } = Astro.props;
---

<svg class="fig" viewBox="0 0 64 64" width="64" height="64" data-draw aria-hidden="true">
  {
    name === 'product' && (
      <>
        {/* roadmap: three lanes and a milestone */}
        <rect class="draw" pathLength="1" x="6" y="10" width="52" height="44" rx="5" />
        <line class="draw acc" pathLength="1" style="--d:300" x1="14" y1="23" x2="38" y2="23" />
        <line class="draw" pathLength="1" style="--d:450" x1="22" y1="32" x2="50" y2="32" />
        <line class="draw" pathLength="1" style="--d:600" x1="14" y1="41" x2="30" y2="41" />
        <path class="pop fill-acc" style="--d:900" d="M 44 36 L 49 41 L 44 46 L 39 41 Z" />
      </>
    )
  }
  {
    name === 'code' && (
      <>
        {/* browser window with brackets */}
        <rect class="draw" pathLength="1" x="6" y="10" width="52" height="44" rx="5" />
        <line class="draw" pathLength="1" style="--d:250" x1="6" y1="21" x2="58" y2="21" />
        <circle class="pop fill-acc" style="--d:500" cx="13" cy="15.5" r="1.8" />
        <path class="draw acc" pathLength="1" style="--d:550" d="M 25 30 L 18 37.5 L 25 45" />
        <path class="draw acc" pathLength="1" style="--d:700" d="M 39 30 L 46 37.5 L 39 45" />
        <line class="draw" pathLength="1" style="--d:850" x1="34.5" y1="28" x2="29.5" y2="47" />
      </>
    )
  }
  {
    name === 'growth' && (
      <>
        {/* rising chart */}
        <path class="draw" pathLength="1" d="M 8 8 V 56 H 58" />
        <path class="draw acc" pathLength="1" style="--d:350" d="M 15 46 L 27 36 L 36 41 L 52 20" />
        <path class="draw acc" pathLength="1" style="--d:900" d="M 43 20 H 52 V 29" />
        <circle class="pop fill-acc" style="--d:700" cx="27" cy="36" r="2.2" />
        <circle class="pop fill-acc" style="--d:800" cx="36" cy="41" r="2.2" />
      </>
    )
  }
</svg>
