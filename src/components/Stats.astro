---
import { stats } from '../data/resume';
---

<section class="section">
  <div class="wrap">
    <p class="eyebrow mb-10" data-reveal><span class="text-accent">04</span> &nbsp;/&nbsp; In numbers</p>
    <dl class="grid grid-cols-2 gap-x-6 gap-y-10 md:grid-cols-3 lg:grid-cols-5">
      {
        stats.map((s, i) => (
          <div class="flex flex-col-reverse justify-end border-t border-ink pt-4" data-reveal style={`--i:${i}`}>
            <dt class="mt-2 text-sm text-muted">{s.label}</dt>
            <dd class="display text-[clamp(2.4rem,5vw,3.5rem)] tabular-nums">
              <span data-count={s.value}>{s.value.toLocaleString('en-US')}</span>
              <span class="text-accent">{s.suffix}</span>
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
