---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Strengths from '../components/Strengths.astro';
import SectionHeading from '../components/SectionHeading.astro';
import WorkCard from '../components/WorkCard.astro';
import Timeline from '../components/Timeline.astro';
import Stats from '../components/Stats.astro';
import Leadership from '../components/Leadership.astro';
import Skills from '../components/Skills.astro';
import Contact from '../components/Contact.astro';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---

<Base>
  <Hero />
  <Strengths />

  <section class="section" id="work">
    <div class="wrap">
      <SectionHeading index="02" label="Selected work" title="Three projects, from scoping to results." />
      <div class="grid gap-x-8 gap-y-14 md:grid-cols-3">
        {work.map((entry, i) => <WorkCard entry={entry} index={i} />)}
      </div>
    </div>
  </section>

  <Timeline />
  <Stats />
  <Leadership />
  <Skills />
  <Contact />
</Base>
